rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    // Check if user is authenticated
    // Helper: Check if user owns the data (email match)
    function isOwner(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    match /subscribers/{subscriberId} {
      // Admin Write (allowing all for now as Admin is anonymous in this setup)
      allow write: if true; 

      // Reverting to allow read for Admin Panel (which is unauthenticated)
      allow read: if true;
    }

    match /sales/{saleId} {
      allow read, write: if true; 
    }

    match /dailyMenu/{menuId} {
      allow read: if true; // Public
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
